<Project Sdk="Microsoft.NET.Sdk">

  <!-- ProjectGuid is only included as a requirement for SonarQube analysis, matching the
       convention every other project in this tree follows. -->
  <PropertyGroup>
    <ProjectGuid>{6E9F2B71-6C31-4F1D-9F4C-2A7B5E0D18A3}</ProjectGuid>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>StingStream.Core</RootNamespace>
    <AssemblyName>StingStream.Core</AssemblyName>
    <!-- SharedVersion.cs below already carries the assembly version attributes, exactly as it does
         for every other project in this tree; letting the SDK generate them too is a duplicate
         attribute error. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    StingStream's own code opts out of Jellyfin's warnings-as-errors and its Debug-only
    AllEnabledByDefault analysis mode.

    Jellyfin sets TreatWarningsAsErrors=true and AnalysisMode=AllEnabledByDefault in its root
    Directory.Build.props, and src/Directory.Build.props adds StyleCop plus four more analyzers to
    every project under src/. Those settings encode Jellyfin's house style, which this project (new
    StingStream code that happens to live inside the fork so it can reach ILibraryManager) is not
    written to. Inheriting them would mean either rewriting StingStream's code to a different
    project's conventions or scattering suppressions through it. Warnings still surface; they just
    do not fail the build. Recorded in docs/PATCHES.md.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- SA*: StyleCop house style. CS1591: XML docs are required by GenerateDocumentationFile,
         which we keep on so Swashbuckle can pick up the comments we do write. -->
    <NoWarn>$(NoWarn);SA0001;SA1101;SA1200;SA1201;SA1202;SA1204;SA1309;SA1311;SA1413;SA1600;SA1601;SA1602;SA1633;SA1649;CS1591;CA1002;CA1031;CA1054;CA1056;CA1062;CA1707;CA1848;CA2007;CA1812;CA1861;IDE0058</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SharedVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Added to Directory.Packages.props by StingStream; see docs/PATCHES.md. -->
    <PackageReference Include="MonoTorrent" />
    <PackageReference Include="Blake3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MediaBrowser.Common\MediaBrowser.Common.csproj" />
    <ProjectReference Include="..\..\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
    <ProjectReference Include="..\..\MediaBrowser.Model\MediaBrowser.Model.csproj" />
  </ItemGroup>

  <!-- A class library hosting MVC controllers needs the ASP.NET Core shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
