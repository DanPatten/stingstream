{
  "name": "@stingstream/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client generated from the StingStream OpenAPI spec (StingStream.Core, /stingstream/api/v1).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "fetch-openapi": "tsx scripts/fetch-openapi.ts",
    "generate": "tsx scripts/generate.ts",
    "check": "tsx scripts/check.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
