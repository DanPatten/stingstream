# Copy to `.env` next to compose.yml and edit. Every value here is used by compose.yml.

# The coordinator's own public name. Must already resolve to this host.
COORDINATOR_HOSTNAME=coord.example.org

# The domain whose `direct.` subzone is delegated to this host. The coordinator becomes
# authoritative for `direct.example.org`, and every node gets names under it.
BASE_DOMAIN=example.org

# This host's public addresses, comma-separated. Answered for the zone apex and for every
# `relay.<nodeid>.direct.<domain>` name, which is where SNI passthrough lands.
PUBLIC_IPS=203.0.113.7

# The NS names in your delegation. Comma-separated; defaults to ns1.<BASE_DOMAIN>.
NS_NAMES=ns1.example.org

# Let's Encrypt account contact.
ACME_CONTACT=ops@example.org

# Leave true until a staging certificate has been issued successfully. Production rate limits are
# unforgiving of a misconfigured first attempt.
ACME_STAGING=true

RUST_LOG=stingstream_relay=info,iroh_relay=info,warn

# --- the `storage-node` profile (M8) -----------------------------------------------------------
STORAGE_NODE_JOIN_CODE=
STORAGE_NODE_NAME=seedbox
STORAGE_NODE_MEDIA=./media
