EXPO_PUBLIC_WRITE_DEBUG=0

# StingStream is a fork, and the DSN utils/sentry.ts falls back to when this is unset belongs to
# upstream Streamyfin's own Sentry org ("streamyfin", project "react-native") — release builds
# would otherwise report StingStream's crashes there without anyone's consent. Empty disables
# Sentry entirely until Dan points it at a project of his own (utils/sentry.ts's own comment
# documents this override). See docs/APP-RELEASE.md.
EXPO_PUBLIC_SENTRY_DSN=